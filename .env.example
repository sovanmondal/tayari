# --- Database ---
DATABASE_URL=postgresql+psycopg://tayari:tayari@db:5432/tayari

# --- Upstream real data sources (public, no key required) ---
HDX_BASE=https://data.humdata.org/api/3/action
HDX_ORG=igad-climate-prediction-and-application-center
STAC_BASE=https://raw.githubusercontent.com/icpac-igad/stac-api/refs/heads/main/ibf_catalog
GEONODE_BASE=https://geoportal.icpac.net/api/v2

# --- LLM (optional; system falls back to deterministic templates if unset) ---
# LLM_PROVIDER options: bedrock | openai | template
LLM_PROVIDER=template
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_REGION=us-east-1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- SMS (optional; Africa's Talking sandbox). If unset, dispatch is simulated. ---
# AT_USERNAME=sandbox
# AT_API_KEY=
AT_SENDER=TAYARI

# --- App ---
FRONTEND_ORIGIN=http://localhost:5173
CACHE_TTL_SECONDS=3600
